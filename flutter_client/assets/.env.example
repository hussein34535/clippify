# Clippify Flutter Client — Environment Variables
# Loaded by main.dart via `dotenv.load(fileName: "assets/.env")`.
# Copy this file to `assets/.env` and adjust as needed.

# FastAPI backend base URL (no trailing slash)
API_BASE_URL=http://localhost:8000

# WebSocket URL for real-time collaboration
API_WS_URL=ws://localhost:8000/ws

# Backend verification path (used by BackendController to confirm FastAPI is up)
BACKEND_VERIFY_PATH=/docs
