# =====================================================
# Clippify Studio — Environment Configuration
# =====================================================
# Copy this file to `.env` and fill in your real keys.
# .env is git-ignored (never commit secrets).
# =====================================================

# ---------- LLM (Google Gemma / Gemini) ----------
# Get from: https://aistudio.google.com/apikey
# Used by: AI Copilot, smart editing, plan generation
GEMMA_API_KEY=your_gemma_api_key_here

# ---------- Stock Footage APIs ----------
# Pexels: https://www.pexels.com/api/
# Used by: B-roll auto-suggest
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay: https://pixabay.com/api/docs/
# Used by: B-roll fallback
PIXABAY_API_KEY=your_pixabay_api_key_here

# ---------- Sound Effects (optional) ----------
# Freesound: https://freesound.org/apiv2/apply
# Used by: SFX auto-insert
FREESOUND_API_KEY=your_freesound_api_key_here

# ---------- Translation (optional) ----------
# DeepL: https://www.deepl.com/pro-api
# Used by: Subtitle auto-translation
DEEPL_API_KEY=your_deepl_api_key_here

# Google Cloud Translation (alternative)
# Get from: https://cloud.google.com/translate/docs/setup
GOOGLE_TRANSLATE_KEY=your_google_translate_key_here

# ---------- Whisper (offline transcription) ----------
# tiny | base | small | medium | large
WHISPER_MODEL=tiny

# ---------- Output ----------
# Default export directory
OUTPUT_DIR=./output

# ---------- Auth & Billing ----------
# JWT signing secret (MUST change in production)
JWT_SECRET=change-me
# Require Bearer auth on /api/* (except /api/auth/*, /api/health)
REQUIRE_AUTH=false
# Stripe billing (leave empty → mock checkout URLs in dev)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Cloud database / queue / storage (cloud mode only)
DATABASE_URL=sqlite:///./clippify.db
REDIS_URL=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public base URL used for Stripe success/cancel redirects
PUBLIC_BASE_URL=http://localhost:8000

# ---------- LLM Router (zero-bill cascade + BYOK) ----------
# Secret for encrypting BYOK keys in providers.db via Fernet (MUST change in production)
APP_SECRET=
# Local Ollama endpoint (free chain hop; checked via GET /api/tags)
OLLAMA_URL=http://localhost:11434
# Groq free tier key (https://console.groq.com/keys) — llama-3.3-70b-versatile
GROQ_API_KEY=
# Optional JSON override of daily caps, e.g. {"gemini_free":1500,"groq_free":200,"ollama":1000000000}
PROVIDER_CAPS=
# SQLite db holding BYOK keys + usage ledger/cooldowns
CLIPPIFY_PROVIDERS_DB=./providers.db

# HuggingFace token (free) � required once for gated pyannote diarization models
HF_TOKEN=
