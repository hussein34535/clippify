# Clippify background worker (RQ). GPU variant later:
#   swap base to nvidia/cuda:12.x-runtime-ubuntu22.04 (placeholder) and
#   pip-install the torch/cuda wheels — CMD stays identical.
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV STORAGE_DIR=/app/storage \
    DATABASE_URL=sqlite:////app/data/clippify.db \
    PYTHONUNBUFFERED=1

# python -m jobs == rq worker on queue "clippify" (see jobs/__main__.py)
CMD ["python", "-m", "jobs"]
